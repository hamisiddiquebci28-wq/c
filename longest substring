#include <string>
#include <vector>
#include <algorithm>

class Solution {
public:
    int lengthOfLongestSubstring(std::string s) {
        // Map to store the last seen index of each character
        // Using a vector of size 128 covers all standard ASCII characters
        std::vector<int> last_seen(128, -1);
        
        int max_len = 0;
        int left = 0; // Left boundary of the sliding window
        
        for (int right = 0; right < s.length(); ++right) {
            char current_char = s[right];
            
            // If the character was seen before and is inside the current window
            if (last_seen[current_char] >= left) {
                // Shrink the window by moving left past the duplicate's last position
                left = last_seen[current_char] + 1;
            }
            
            // Update the last seen position of the character
            last_seen[current_char] = right;
            
            // Calculate the current window size and track the maximum
            max_len = std::max(max_len, right - left + 1);
        }
        
        return max_len;
    }
};
