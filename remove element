#include <vector>

class Solution {
public:
    int removeElement(std::vector<int>& nums, int val) {
        // Pointer to keep track of the position for elements not equal to val
        int k = 0; 
        
        // Scan through the array element by element
        for (int i = 0; i < nums.size(); ++i) {
            // If the current element is valid (not equal to val)
            if (nums[i] != val) {
                nums[k] = nums[i]; // Move it to the valid prefix section
                k++;               // Shift the valid boundary index forward
            }
        }
        
        // Return the total count of valid elements
        return k;
    }
};
