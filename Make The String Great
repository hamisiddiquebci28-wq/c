char* makeGood(char* s) {
    int length = strlen(s);
    for(int i = 0 ; i < length-1 ; i++) {
        if(s[i] - s[i+1] == 32 || s[i] - s[i+1] == -32) {
            if(s[i+2] == '\0') {
                return "";
            }
            for(int j = i ; j < length-2 ; j++) {
                s[j] = s[j+2];
            }
            i = -1;
            length -= 2;
        }
    }
    s[length] = '\0';
    return s;
}
