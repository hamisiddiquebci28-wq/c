#include <stdbool.h>

// Helper function to calculate the sum of the squares of digits
int getNext(int n) {
    int totalSum = 0;
    while (n > 0) {
        int d = n % 10;
        totalSum += d * d;
        n /= 10;
    }
    return totalSum;
}

bool isHappy(int n) {
    int slow = n;
    int fast = getNext(n);
    
    // Loop until fast reaches 1 or catches up to slow
    while (fast != 1 && slow != fast) {
        slow = getNext(slow);          // Moves 1 step
        fast = getNext(getNext(fast));  // Moves 2 steps
    }
    
    // If fast reached 1, it's a happy number
    return fast == 1;
}
